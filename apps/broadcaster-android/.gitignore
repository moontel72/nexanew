# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Android Studio
*.iml
.idea/
.DS_Store

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/
.cxx/

# Google Services
google-services.json

# A stale copy of a Flutter `android/` project sits under this native app
# (`apps/broadcaster-android/android/`: same package, plus old `.iml`/`java`
# leftovers). It is not part of the repository, and leaving it untracked made
# `git status` noisy enough to hide a real change once. Ignore it here rather
# than deleting it — untracked content is unrecoverable, so removal stays a
# deliberate, manual step.
/android/
