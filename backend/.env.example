# ============================================================================
# NEXATRACE — Laravel Backend Environment
# Copy to .env and fill in the secrets. Never commit .env itself.
# ============================================================================

APP_NAME="NexaTrace"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://admin.traceodd.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ─── Database (production runs PostgreSQL) ───────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nexatrace
DB_USERNAME=nexatrace
DB_PASSWORD=

# ─── Cache / Session / Queue ─────────────────────────────────────────────
# cache.php, session.php and queue.php default to `database`; Redis is
# required for the cricket score snapshots (LiveScoreService) and the
# active-match context. Point CACHE_STORE at redis in production.
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ─── Real-time: WebSockets (Laravel Reverb) ──────────────────────────────
# CRITICAL: BROADCAST_DRIVER must be `reverb` in production. The default
# `log` silently drops every cricket broadcast event and the Rust media
# engine falls back to REST polling (the push-first scoreboard dies).
BROADCAST_DRIVER=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public URL clients connect to (browser/engine side):
REVERB_HOST=cricket-manager.traceodd.com
REVERB_PORT=443
REVERB_SCHEME=https
# Local bind for the reverb:start server process:
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Optional tuning:
# REVERB_PING_INTERVAL=10
# REVERB_ACTIVITY_TIMEOUT=30
# REVERB_MAX_MESSAGE_SIZE=10000

# ─── Todd Studio SSO → Rust media engine ────────────────────────────────
# Base URL of the media engine control plane (todd-signaling).
MEDIA_ENGINE_URL=http://127.0.0.1:8080
# CRITICAL: must be IDENTICAL to the Rust engine's JWT_SECRET (>= 32 chars)
# so tokens minted by MediaEngineTokenService verify locally in the engine.
MEDIA_ENGINE_JWT_SECRET=
MEDIA_ENGINE_JWT_ISSUER=traceodd

# ─── Legacy replay chunker / HLS pipeline ────────────────────────────────
RUST_CHUNKER_URL=http://127.0.0.1:9090

# ─── Cricket module ──────────────────────────────────────────────────────
# SRS ingest for OBS (port 1935 default) and HLS delivery base.
CRICKET_RTMP_INGEST_URL=rtmp://cricket.traceodd.com:1935/live
CRICKET_HLS_BASE_URL=https://cricket.traceodd.com/hls/live
# Rust OCR / scoring CLI binary on the server.
CRICKET_RUST_BINARY=/opt/nexatrace/trace_odd_rust

# ─── Filesystem ──────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ─── Mail (log driver by default — no SMTP side effects) ────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@traceodd.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Optional third-party integrations ───────────────────────────────────
# POSTMARK_API_KEY=
# RESEND_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=
# DEEPSEEK_API_KEY=
