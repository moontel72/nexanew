-- FACTORY ADMIN TABLES (Code Management)
-- ============================================

-- Factory Users (Admins, Store Keepers, Drivers)
CREATE TABLE factory_users (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
