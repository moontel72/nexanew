    payment_date DATE,
    payment_method VARCHAR(50),
    payment_reference VARCHAR(255),

    -- Metadata
    notes TEXT,
    metadata JSONB DEFAULT '{}',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
