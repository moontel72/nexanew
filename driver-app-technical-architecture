## 6. Data Model (PostgreSQL)
### 6.1 Data model definition
```mermaid
erDiagram
    DRIVER ||--o{ TRIP : assigns
    TRIP ||--o{ EXPENSE : contains
    TRIP ||--|{ POD : has
    DRIVER ||--o{ VEHICLE : operates
    VEHICLE ||--o{ MAINTENANCE : logs

    DRIVER {
        UUID id PK
        string name
        string phone
        date license_expiry
        string tier
        boolean blocked
    }
    TRIP {
        UUID id PK
        UUID driver_id FK
        string status
        string pickup_address
        string delivery_address
        timestamp delivery_window_start
        timestamp delivery_window_end
        float delivery_lat
        float delivery_lng
        jsonb route_history
    }
    EXPENSE {
        UUID id PK
        UUID trip_id FK
        string type
        numeric amount
        string receipt_url
        boolean mandatory
        boolean approved
        UUID approved_by
        timestamp submitted_at
    }
    POD {
        UUID id PK
        UUID trip_id FK
        string verification_type
        jsonb verification_payload
        jsonb photos
        timestamp completed_at
    }
    VEHICLE {
        UUID id PK
        UUID driver_id FK
        string plate_number
        date insurance_expiry
        date registration_expiry
    }
    MAINTENANCE {
        UUID id PK
        UUID vehicle_id FK
        string type
        date service_date
        date next_service_date
    }
```
