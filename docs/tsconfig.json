// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
//
// NOTE: self-contained on purpose — the template's "@docusaurus/tsconfig"
// base carries a deprecated `baseUrl` that forces TS 6's
// "ignoreDeprecations": "6.0", which older editor-bundled TypeScript (5.x)
// rejects. This config is valid on both.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["src", "*.ts", "*.tsx", "docs/**/*.mdx"],
  "exclude": [".docusaurus", "build"]
}
