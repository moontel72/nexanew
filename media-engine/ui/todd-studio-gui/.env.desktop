# ============================================================================
# Todd Studio GUI — DESKTOP (Tauri) build environment
# ============================================================================
# Used by `npm run build:desktop` (scripts/build-desktop.mjs): every value
# below is injected as a process env var for the Vite build inside `tauri
# build`, so the packaged .exe bakes these in. Pre-set shell variables of
# the same name always win — override per build:
#
#   PowerShell:  $env:VITE_API_BASE_URL="http://10.0.0.5:8080"; npm run build:desktop
#   bash:        VITE_API_BASE_URL=http://10.0.0.5:8080 npm run build:desktop
#
# NOTE: the packaged app origin is tauri://localhost — the media engine
# must allow it in CORS_ALLOWED_ORIGINS (and the Laravel backend for
# /api/v1/studio/*) for the desktop app to connect.
# ============================================================================

# Media engine (todd-signaling) control plane. Defaults to a LOCAL engine
# on the broadcast machine; set this to the engine's LAN/public origin
# (e.g. http://135.181.46.27:8082) to drive a remote engine.
VITE_API_BASE_URL=http://127.0.0.1:8080

# Optional separate WHEP egress origin (falls back to VITE_API_BASE_URL).
VITE_WHEP_BASE_URL=

# Phase-1 SSO identity provider (Laravel). MUST be absolute in the
# packaged app — a relative path would resolve against tauri://localhost.
VITE_STUDIO_LOGIN_URL=https://studio.traceodd.com/api/v1/studio/login

# Cricket manager data source (ball-by-ball score).
VITE_CRICKET_MANAGER_URL=https://cricket-manager.traceodd.com

# Optional seed match for the scoreboard on startup (runtime cricket
# config on the engine overrides this). Pinned empty so local dev
# overrides never leak into the packaged build.
VITE_CRICKET_MATCH_IDS=

# WebRTC ICE for WHEP viewers (STUN/TURN).
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=

# Optional remote 3D/WebM-alpha asset base (default: local /public/assets).
VITE_GFX_ASSET_URL=
