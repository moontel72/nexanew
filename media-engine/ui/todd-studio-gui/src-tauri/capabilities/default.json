{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Todd Studio main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://docs.traceodd.com/**" }, { "url": "https://traceodd.com/download/**" }]
    }
  ]
}
