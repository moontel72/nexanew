# ============================================================================
# Todd Studio GUI — environment
# Copy to .env (never commit). Tauri/Vite reads VITE_* at build time.
# ============================================================================

# Backend media engine (todd-signaling) — REST + WHEP/telemetry endpoints.
VITE_API_BASE_URL=http://127.0.0.1:8080

# Optional separate WHEP egress origin (falls back to VITE_API_BASE_URL).
VITE_WHEP_BASE_URL=

# Phase-1 SSO identity provider (Laravel) — POST {email, password} here.
# Relative path → same-origin (studio nginx proxies /api/v1/studio/*).
# Absolute https://admin.traceodd.com/api/v1/studio/login also works once
# that DNS record exists.
VITE_STUDIO_LOGIN_URL=/api/v1/studio/login

# Cricket manager data source (ball-by-ball score).
VITE_CRICKET_MANAGER_URL=https://cricket-manager.traceodd.com

# WebRTC ICE for WHEP viewers (STUN/TURN).
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=

# Optional remote 3D/WebM-alpha asset base (default: local /public/assets).
VITE_GFX_ASSET_URL=

# ----------------------------------------------------------------------------
# Desktop (Tauri) packaging
# ----------------------------------------------------------------------------
# `npm run build:desktop` bakes the committed `.env.desktop` template into
# the packaged .exe (build-time values — `import.meta.env` is frozen).
# Override any value per build by pre-setting the same VITE_* variable in
# the shell (process env wins over .env files):
#
#   PowerShell:  $env:VITE_API_BASE_URL="http://10.0.0.5:8080"; npm run build:desktop
#   bash:        VITE_API_BASE_URL=http://10.0.0.5:8080 npm run build:desktop
#
# The packaged app origin is tauri://localhost, so the media engine must
# include it in CORS_ALLOWED_ORIGINS and the SSO login URL must be
# absolute (see .env.desktop).
