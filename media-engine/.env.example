# ============================================================================
# T-Odd Media Engine — shared environment (Studio + Broadcaster)
# Copy to .env and fill in real values. NEVER commit .env.
# Full reference: docs/06-ice-and-telemetry.md
# ============================================================================

# --- auth (REQUIRED) --------------------------------------------------------
# 64+ random chars, identical on Laravel and the engine.
#   openssl rand -base64 48
JWT_SECRET=

# --- studio (control plane) -------------------------------------------------
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
ROOM_TTL_SECS=3600
INGEST_TOKEN_TTL_SECS=300
# embedded = broadcaster inside the studio process; remote = standalone service
MEDIA_PLANE=embedded
BROADCASTER_URL=http://127.0.0.1:8081
# memory = single instance; redis = shared across replicas/hosts
ROOM_STORE=memory
REDIS_URL=redis://127.0.0.1:6379/0
# Optional: validate opaque (Sanctum) tokens via Laravel
LARAVEL_INTROSPECTION_URL=
# Phase 2 browser clients, e.g. https://cricket.traceodd.com
CORS_ALLOWED_ORIGINS=
# Dev-only browser WHIP/WHEP test page at GET /whiptest
DEV_TEST_PAGE=0

# --- broadcaster (media plane) ----------------------------------------------
BROADCASTER_HOST=127.0.0.1
BROADCASTER_PORT=8081
STUN_SERVERS=stun:stun.l.google.com:19302
# TURN_SERVERS=turnuser:turnpass@media.traceodd.com:3478 (see coturn.conf)
TURN_SERVERS=

# --- ICE / network policy ----------------------------------------------------
# Interface allow-list (comma-separated names). Empty = all routable interfaces.
ICE_INTERFACES=
# Interface deny-list (prefix-matched). Defaults exclude virtual adapters.
ICE_INTERFACE_DENY=docker,veth,br-,virbr,vmnet,vEthernet,VMware,VirtualBox,Hyper-V,wsl,utun
# 1:1 NAT public IPs advertised as host candidates (e.g. cloud floating IP).
ICE_PUBLIC_IPS=
# Pin the ICE ephemeral UDP port range (deterministic firewall rules).
ICE_UDP_PORT_MIN=
ICE_UDP_PORT_MAX=
# ICE timeouts (ms): disconnected / failed / keep-alive (consent freshness).
ICE_DISCONNECTED_TIMEOUT_MS=5000
ICE_FAILED_TIMEOUT_MS=15000
ICE_KEEPALIVE_INTERVAL_MS=2000
# Server-side grace before a Disconnected session is proactively closed.
ICE_DISCONNECTED_GRACE_MS=8000
# Dev only: advertise 127.0.0.1 as a host candidate.
ICE_LOOPBACK=0

# --- replay -----------------------------------------------------------------
# Ring buffer retention window for cricket instant replay (ms, 5s-30s).
REPLAY_BUFFER_MS=15000
# Optional webhook notified on clip-export completion (TraceOdd cloud).
REPLAY_EXPORT_CALLBACK_URL=

# --- telemetry ---------------------------------------------------------------
TELEMETRY_SAMPLE_MS=2000
TELEMETRY_WS_INTERVAL_MS=1000

# --- logging -----------------------------------------------------------------
LOG_FILTER=info
