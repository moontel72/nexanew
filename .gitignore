# ── Flutter / Dart: build output + generated toolchains ────────────────────
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
build/
coverage/

# Qoder / VS Code-based agents: heavy generated + build artifacts.
# NOTE: `pubspec.lock` aur `linux|windows/flutter/` ke andar ke generated files
# git me TRACKED hain (Flutter app ke liye zaroori) — gitignore inhe untrack
# nahi karta. In par skip IDE-level settings se lagta hai:
#   .vscode/settings.json  → search.exclude / files.exclude
#   .qoder/rules/          → Qoder agent rule
pubspec.lock
linux/flutter/
windows/flutter/
backend/storage/logs/

# (build/, .dart_tool/ aur *.log upar already ignore ho chuke hain.)

*.log

.idea/
# `.vscode/*` (poori dir ke bajaye) taake shared settings.json track ho sake.
.vscode/*
!.vscode/settings.json

**/.env
**/.env.*
!**/.env.example
!**/.env.desktop

backend/vendor/
backend/storage/
backend/bootstrap/cache/
backend/public/storage

node_modules/

.composer/

rust/target/
**/target/
rust/target_check/
**/target_check/

# cargo metadata dump (generated build artifact)
media-engine/meta.json

.trae/

analysis_output.txt

# Operator-collected field evidence (logs, dumps, adb output) — keep local,
# never commit production logs/session ids.
/qoder-evidence/
/qoder-evidence2/
/qoder-evidence*/

*.iml
.DS_Store

.aider*

# Zed agent escape-hatch transient state (see AGENTS.md)
.zed/agent-scan-overrides.json
.zed/.settings.agent-backup.json
